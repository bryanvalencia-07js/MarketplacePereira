PORT=3000
NODE_ENV=development
DATA_SOURCE=memory
# Requeridas solo con DATA_SOURCE=mysql. Crear primero la base y el usuario.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reactiva_pereira
DB_USER=reactiva_app
DB_PASSWORD=
